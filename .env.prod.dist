# Copy this file to .env.prod and fill in real values.
# .env.prod is gitignored — never commit it.
#
# docker-compose reads this file via `env_file: .env.prod` and injects every
# variable into both the `app` and `db` containers.  Symfony's Dotenv reads
# the committed .env as a baseline but does NOT override values already set
# in the process environment, so these docker-compose values always win.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Database (app container) ─────────────────────────────────────────────────
# Host must be `db` — the Docker Compose service name, not 127.0.0.1
DATABASE_URL=mysql://cgc:CHANGE_ME_db_password@db:3306/cgc

# ── Database (db container) ──────────────────────────────────────────────────
MYSQL_DATABASE=cgc
MYSQL_USER=cgc
MYSQL_PASSWORD=CHANGE_ME_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

# ── Mailer ───────────────────────────────────────────────────────────────────
MAILER_DSN=smtp://CHANGE_ME_smtp_user:CHANGE_ME_smtp_password@CHANGE_ME_smtp_host:587

# ── QuickBooks OAuth ─────────────────────────────────────────────────────────
QUICKBOOKS_AUTH_URL=https://appcenter.intuit.com/connect/oauth2
QUICKBOOKS_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
QUICKBOOKS_OAUTH_SCOPE="com.intuit.quickbooks.accounting openid profile email phone address"
QUICKBOOKS_OAUTH_REDIRECT_URL=https://CHANGE_ME_your_domain/oauth/redirect
QUICKBOOKS_CLIENT_ID=CHANGE_ME
QUICKBOOKS_SECRET=CHANGE_ME

# ── Optional: trusted proxy (nginx sits in front of php-fpm on 172.x) ───────
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# TRUSTED_HOSTS=CHANGE_ME_your_domain
