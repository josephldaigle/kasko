<div class="col-12 px-0 site-footer">
    <div class="row footer mx-0 px-4 px-md-5 py-4">

        {# COLUMN LEFT #}
        <div class="col-12 col-md-4 mb-4 mb-md-0">
            <h5 class="font-weight-bold text-uppercase mb-3">About</h5>

            <ul class="footer-nav navbar-nav">

                {% for menu_item in template_data.get('menus').get('footer_menu') %}

                    <li class="nav-item text-left mb-2">
                        <a href="{{ path(menu_item.routeName) }}">{{ menu_item.displayText}}</a>
                    </li>

                {% endfor %}

            </ul>

        </div>

        {# COLUMN MIDDLE #}
        <div class="col-12 col-md-4 mb-4 mb-md-0">

            <!-- Contact details -->
            <h5 class="font-weight-bold text-uppercase mb-3">Contact</h5>
            <ul class="list-unstyled">
                <li class="mb-3">
                    <a target="_blank" jstcache="25" href="https://maps.google.com/maps?ll=32.66749,-83.774481&amp;z=12&amp;t=m&amp;hl=en&amp;gl=US&amp;mapclient=embed&amp;cid=545253647663484353" jsaction="mouseup:placeCard.largerMap">
                        <i class="fas fa-home mr-2 mt-1 pr-3 text-primary float-left"></i>{{  'Kasko Construction, LLC' }}
                    </a>
                </li>
                <li class="mb-3">
                    <a href="mailto:{{ company_email }}">
                        <i class="fas fa-envelope mr-2 pr-3 mt-1 text-primary"></i>{{ company_email }}
                    </a>
                </li>
                <li class="mb-3">
                    <a href="tel:1-{{ company_phone | replace({'(' : '', ') ': '-'}) }}">
                        <i class="fas fa-phone mr-2 mt-1 pr-3 text-primary"></i>{{ company_phone }}
                    </a>
                </li>
            </ul>

        </div>


        {# COLUMN RIGHT #}
        <div class="col-12 col-md-4">
            <h5 class="font-weight-bold text-uppercase mb-3">Follow Us</h5>
            {# TODO: add KasKo social / affiliate links when available #}
        </div>

        <div class="col-12 border-top mt-4 pt-3">
            <p class="text-center text-black mb-0 shrink-font-1">&#169;&nbsp; 2026 Kasko Construction, LLC, All rights reserved.</p>
        </div>
    </div>
</div>
