{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Contact KasKo Construction & Remodeling' }}{% endblock %}
{% block page_meta_description %}{{ 'Contact KasKo Construction & Remodeling for remodeling, repairs, decks, and outdoor living projects throughout Middle Georgia.' }}{% endblock %}
{% block page_content %}

    {% embed 'layouts/right-sidebar.html.twig' %}

        {% block layout_page_title %}
            {{ 'Contact & Service Area' }}
        {% endblock %}

        {% block layout_main_content %}
            <div class="col-12">
                <p>Serving Byron, Warner Robins, Macon, Perry, Fort Valley, and surrounding Middle Georgia communities.</p>
                <div class="row mt-4 mb-4">
                    <div class="col-12 col-md-4 mb-3 mb-md-0">
                        <a class="d-flex align-items-center text-link" href="tel:1-{{ company_phone | replace({'(': '', ') ': '-'})}}">
                            <i class="fas fa-phone text-forest mr-3 flex-shrink-0" style="font-size: 1.5rem;"></i>
                            <span>{{ '(478) 283-3355' }}</span>
                        </a>
                    </div>

                    <div class="col-12 col-md-4 mb-3 mb-md-0">
                        <a class="d-flex align-items-center text-link" href="mailto:{{ company_email }}">
                            <i class="fas fa-envelope text-forest mr-3 flex-shrink-0" style="font-size: 1.5rem;"></i>
                            <span>{{ company_email }}</span>
                        </a>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="d-flex align-items-center">
                            <i class="far fa-clock text-forest mr-3 flex-shrink-0" style="font-size: 1.5rem;"></i>
                            <div>
                                Mon–Sat<br />
                                8:00 AM–6:00 PM
                            </div>
                        </div>
                    </div>
                </div>

                {# Replace this Google Maps embed with a custom service-area map later. #}
                <iframe
                        class="mt-3 w-100"
                        id="google-map-embed"
                        title="KasKo Construction & Remodeling service area"
                        src="https://maps.google.com/maps?q=Middle+Georgia&t=&z=9&ie=UTF8&iwloc=&output=embed"
                        width="600"
                        height="375"
                        style="border:0"
                        loading="lazy"
                        allowfullscreen
                ></iframe>

            </div>

        {% endblock %}

        {% block layout_sbr %}
            {% include 'components/forms/quote-request.html.twig' %}
            <div class="w-100 mb-3"></div>
            {% include 'components/testimonials.html.twig' %}
        {% endblock %}

    {% endembed %}

{% endblock %}
