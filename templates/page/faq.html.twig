{# twig template #}
{% extends 'base.html.twig' %}

{% block page_title %}{{ 'Frequently Asked Questions - KasKo Construction & Remodeling' }}{% endblock %}
{% block page_meta_description %}{{ 'Answers to common questions about working with KasKo Construction & Remodeling in Middle Georgia.' }}{% endblock %}


{% block page_content %}

    {% embed 'layouts/right-sidebar.html.twig' %}

        {% block layout_header_left %}
            {% include 'components/header/logo.html.twig' %}
        {% endblock %}

        {% block layout_header_middle %}{% endblock%}

        {% block layout_header_right %}
            {% include 'components/header/call-now.html.twig' %}
        {% endblock %}

        {% block layout_page_title %}
            Frequently Asked Questions
        {% endblock %}

        {% block layout_main_content %}
            <div class="col-12">
                <div class="accordion w-100 mb-3" id="faq-accordion">

                    {% for question in questions %}
                        <div class="border-bottom py-2">
                            <div id="heading{{ loop.index }}">
                                <button
                                        class="btn btn-link w-100 text-left px-0 py-3 text-primary"
                                        type="button"
                                        data-toggle="collapse"
                                        data-target="#collapse{{ loop.index }}"
                                        aria-expanded="{{ loop.first ? 'true' : 'false' }}"
                                        aria-controls="collapse{{ loop.index }}"
                                >
                                    <div class="d-flex align-items-center justify-content-between">
                                        <h5 class="mb-0">
                                            {{ question.question }}
                                        </h5>

                                        <i class="fas fa-caret-down ml-3 rotate-if-collapsed"></i>
                                    </div>
                                </button>
                            </div>

                            <div
                                    id="collapse{{ loop.index }}"
                                    class="collapse {% if loop.first %}show{% endif %}"
                                    aria-labelledby="heading{{ loop.index }}"
                                    data-parent="#faq-accordion"
                            >
                                <div class="pb-3 pr-md-5 text-dark">
                                    {{ question.answer | raw }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                </div>
            </div>
        {% endblock %}

        {% block layout_sbr %}
            {% include 'components/forms/quote-request.html.twig' %}
            <div class="w-100 mb-3"></div>
            {% include 'components/testimonials.html.twig' %}
        {% endblock %}

    {% endembed %}

    {% include 'components/media/insurance-certificate.html.twig' %}

{% endblock %}
